{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-app111111111",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "a2a4e854-4643-4300-8190-5e3ab9078dce","database_name": "web-app111111111" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "395d10a38ea5441fbc67b73ddf53c3e1" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
